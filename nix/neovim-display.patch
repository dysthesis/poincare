diff --git a/runtime/lua/vim/diagnostic/_store.lua b/runtime/lua/vim/diagnostic/_store.lua
--- a/runtime/lua/vim/diagnostic/_store.lua
+++ b/runtime/lua/vim/diagnostic/_store.lua
@@ -239,6 +239,23 @@ function M.get_buf_namespaces(bufnr)
   return vim.tbl_keys(diagnostic_cache[vim._resolve_bufnr(bufnr)])
 end
 
+-- Keep deferred empty displays enumerable without exposing stale diagnostics.
+--- @param namespace integer
+--- @param bufnr integer
+function M.retain_empty(namespace, bufnr)
+  local cache = diagnostic_cache[vim._resolve_bufnr(bufnr)]
+  cache[namespace] = cache[namespace] or {}
+end
+
+--- @param namespace integer
+--- @param bufnr integer
+function M.release_empty(namespace, bufnr)
+  local cache = rawget(diagnostic_cache, vim._resolve_bufnr(bufnr))
+  if cache and cache[namespace] and vim.tbl_isempty(cache[namespace]) then
+    cache[namespace] = nil
+  end
+end
+
 --- @param namespace integer
 --- @param bufnr integer
 function M.clear(namespace, bufnr)
